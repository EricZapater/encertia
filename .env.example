# =============================================================================
# Encertia Environment Variables Configuration Template
# =============================================================================
# Copy this file to .env before starting containers:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual .env file containing real secrets to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=encertia
DB_SSLMODE=disable

# -----------------------------------------------------------------------------
# Backend Service Configuration (Go / Gin)
# -----------------------------------------------------------------------------
# Port where backend listens (default: 8080)
PORT=8080
BACKEND_PORT=8080

# Gin operational mode: 'debug', 'release', or 'test'
GIN_MODE=debug

# Automatically execute database migrations on application startup ('true' or 'false')
AUTO_MIGRATE=true

# JWT signing secret key (MUST be changed to a secure random string of >= 32 chars in production)
JWT_SECRET=encertia-local-dev-jwt-secret-min-32-chars-long

# Frontend Base URL (used for game join links / playUrl generation)
APP_BASE_URL=https://encertia.ericzapater.cat

# API / Public Base URL (used for local uploads URL generation and public API resolution)
BASE_URL=https://api.encertia.ericzapater.cat

# Local upload directory path (for media uploads stored on local disk)
UPLOAD_DIR=/app/uploads

# -----------------------------------------------------------------------------
# Cloudflare R2 / S3-compatible Object Storage (Optional, falls back to local storage)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Frontend Service Configuration (Vue 3 / Vite)
# -----------------------------------------------------------------------------
# Port mapped on host for the frontend web server (Nginx: 80, or custom host port)
FRONTEND_PORT=80

# Base URL for API requests (by default Nginx proxies /api to backend)
VITE_API_URL=/api

# -----------------------------------------------------------------------------
# Docker Compose Project Configuration
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=encertia
