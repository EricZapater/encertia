# Encertia Backend Configuration Example
PORT=8080
GIN_MODE=release

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_this_password_in_production
DB_NAME=encertia
DB_SSLMODE=disable
AUTO_MIGRATE=true

# Authentication / JWT Security
JWT_SECRET=change_this_jwt_secret_min_32_characters_long_for_security

# Application Base URL (used for external links / WebSocket references)
APP_BASE_URL=https://encertia.ericzapater.cat

# Cloudflare R2 Storage (Optional - falls back to local uploads directory if empty)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Local File Uploads Directory
UPLOAD_DIR=./uploads
