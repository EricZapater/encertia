# =============================================================================
# Encertia - Backend Environment Variables (.env.backend)
# =============================================================================

# PostgreSQL Configuration (connects to existing PostgreSQL in postgres-network)
DB_HOST=postgres
DB_PORT=5432
DB_USER=encertia_user
DB_PASSWORD=your_secure_db_password_here
DB_NAME=encertia_db
DB_SSLMODE=disable

# API Configuration
PORT=8080
GIN_MODE=release
AUTO_MIGRATE=true

# JWT Security (Generate a secure 32+ character random string)
JWT_SECRET=generate-a-strong-secret-key-with-at-least-32-characters

# Frontend Base URL (used for game join links / playUrl generation)
APP_BASE_URL=https://encertia.ericzapater.cat

# Public API / Server Base URL (used for local upload URLs and public endpoint resolution)
BASE_URL=https://api.encertia.ericzapater.cat

# Local Upload Directory
UPLOAD_DIR=/app/uploads

# Cloudflare R2 / S3-compatible Object Storage Configuration
# If configured, media files are stored on Cloudflare R2 instead of local disk
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Timezone
TZ=Europe/Madrid
